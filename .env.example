# --- Required -------------------------------------------------------------
# Only needed if your key isn't scoped to a workspace (the API will tell you).
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# --- Publication ----------------------------------------------------------
NEWSLETTER_NAME=The Kernel
NEWSLETTER_TAGLINE=The tech news worth your time.
# Public URL of this app. Used in email links (confirm, preferences, unsubscribe).
BASE_URL=http://localhost:8000
TIMEZONE=America/New_York

# --- Claude ---------------------------------------------------------------
EDITOR_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Higher = more thorough editing, more tokens.
EDITOR_EFFORT=high
MAX_AGENT_TURNS=60

# --- Web search (https://brave.com/search/api/) ---------------------------
# Optional but recommended. Without it the editor works from the feeds alone.
BRAVE_API_KEY=

# --- Email ----------------------------------------------------------------
# "console" writes emails to outbox/ instead of sending. Switch to "resend" to send.
EMAIL_BACKEND=console
RESEND_API_KEY=
# Until you verify a domain in Resend, onboarding@resend.dev can only send to your own Resend account email.
EMAIL_FROM=The Kernel <onboarding@resend.dev>
EMAIL_REPLY_TO=

# --- Storage --------------------------------------------------------------
# Defaults to SQLite in the project folder. For production use Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/newsletter
DATABASE_URL=

# --- Schedule (in TIMEZONE) -----------------------------------------------
# Run the scheduler in exactly one app instance. Set false if you use cron + the CLI instead.
SCHEDULER_ENABLED=true
DAILY_SEND_HOUR=7
DAILY_SEND_MINUTE=0
WEEKLY_SEND_DAY=sun
WEEKLY_SEND_HOUR=8

# --- Admin ----------------------------------------------------------------
# Visit /admin?token=<this> to build, preview and send issues.
ADMIN_TOKEN=change-me

# --- Video transcription fallback -----------------------------------------
# Off by default. Needs requirements-whisper.txt and ffmpeg.
WHISPER_FALLBACK=false
WHISPER_MODEL=base
